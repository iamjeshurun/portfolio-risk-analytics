# Documentation only: the app reads os.environ and does NOT load this file.
# Export any values you want to override before starting the server, e.g.
#   export CACHE_TTL_HOURS=12
DATABASE_URL=sqlite:///./portfolio.db
CACHE_TTL_HOURS=24
PROVIDER_TIMEOUT_SECONDS=10
# Set to false on a public deployment so saved portfolios are not shared between visitors
SAVED_PORTFOLIOS_ENABLED=true
# Comma-separated browser origins allowed to call the API (only needed when the page is hosted elsewhere)
ALLOWED_ORIGINS=
